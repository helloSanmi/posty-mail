PORT=4010

# Public URL the backend is reachable at from the open internet. Used to:
#   - generate absolute URLs for uploaded assets (logos, images embedded in emails)
#   - auto-allow this origin in CORS
# In dev with a Cloudflare Tunnel or ngrok this is your tunnel URL.
# In production it's your real domain. Falls back to http://localhost:PORT
# when unset, but Gmail/Outlook can't fetch images from localhost — see README.
PUBLIC_BASE_URL=http://localhost:4010

VITE_API_URL=http://localhost:4010

# Optional. Tells the FRONTEND what your backend's public URL is so it can
# render preview / unsubscribe links that work from any device, not just
# the dev machine. If unset, falls back to VITE_API_URL. Match your backend's
# PUBLIC_BASE_URL value (e.g. your Cloudflare Tunnel domain in dev,
# real domain in prod).
VITE_PUBLIC_BASE_URL=
DATABASE_URL=postgresql://campaign:campaign_password@localhost:5432/campaign_app?schema=public

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=campaigns@example.com
BREVO_SENDER_NAME=Campaign Team

# Brevo webhook verification — set ONE of these in production:
#   - BREVO_WEBHOOK_TOKEN: append ?token=<value> to the webhook URL configured in Brevo.
#   - BREVO_WEBHOOK_SECRET: shared HMAC-SHA256 secret; signature read from x-brevo-signature header.
# In production, requests without a configured token/secret will be rejected.
BREVO_WEBHOOK_TOKEN=
BREVO_WEBHOOK_SECRET=

# Auth — required in production. Use 32+ random chars.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-16-chars
# When "true", anyone can register. Otherwise only the very first user can sign up;
# subsequent accounts must be created by an admin via the admin user endpoints.
ALLOW_OPEN_SIGNUP=false

# When "false", the public POST /api/auth/forgot-password endpoint is disabled.
# Default (anything other than "false") allows password resets via the login page —
# fine for local/dev. Set to "false" in production and rely on admin-driven resets
# (Admin → Edit user → New password) instead.
ALLOW_PASSWORD_RESET=true

# Comma-separated list of additional origins permitted by CORS.
# PUBLIC_BASE_URL is auto-allowed; in dev, http://localhost:5173 (Vite) is also
# auto-allowed. Only set this when you have additional origins (e.g. a separate
# frontend deployment). In production, set CORS_ORIGIN or PUBLIC_BASE_URL —
# the server refuses to start if both are missing.
CORS_ORIGIN=

# NODE_ENV=production tightens several behaviors (CORS lockdown, webhook verification required,
# JWT_SECRET strength check). Leave unset for development.
# NODE_ENV=production
