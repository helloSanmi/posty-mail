generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Workspace / tenant. One Account groups a set of Users and all of their
// data (contacts, campaigns, templates, etc). Inviting teammates puts
// them on the same Account; everything below scoped by accountId.
//
// Sender config lives directly on the Account so a per-tenant "From"
// identity is queryable without a JSON dig. Hybrid sender model: when
// these are null, sends fall back to the env-configured shared
// subdomain (the "no setup needed" default).
model Account {
  id            String   @id @default(uuid())
  name          String
  // Optional per-account sender overrides. Null = use the shared
  // platform default. Email is validated at write time + Brevo
  // verification handled by the upgrade flow.
  senderEmail   String?
  senderName    String?
  replyToEmail  String?
  replyToName   String?
  // Free-form per-account preferences (hiddenBuiltins, unsub
  // categories, bounce-sync flag, etc) until each one earns its own
  // column. Mirrors how Contact.data carries optional extras.
  data          Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  contacts      Contact[]
  audiences     Audience[]
  templates     Template[]
  campaigns     Campaign[]
  drafts        Draft[]
  unsubscribes  Unsubscribe[]
  events        Event[]
  campaignSends CampaignSend[]
  segments      Segment[]
  sequences     Sequence[]
  assets        Asset[]
  auditLogs     AuditLog[]
}

model Contact {
  // UUID primary key so the SAME email can exist in different workspaces.
  // Per-account uniqueness is enforced by @@unique([accountId, email])
  // below — within one workspace an email is still unique, across
  // workspaces it's free. Lookups by email always pass accountId too.
  id        String   @id @default(uuid())
  email     String
  firstname String?
  lastname  String?
  consent   String?
  region    String?
  // IANA timezone string (e.g., 'America/New_York'). Optional; when unset,
  // send-time-per-timezone falls back to UTC for that contact. Populated by
  // the subscribe widget (Intl.DateTimeFormat) or imported via CSV.
  timezone  String?
  data      Json?
  savedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, email])
  @@index([accountId])
}

model Audience {
  id            String   @id @default(uuid())
  name          String
  contactEmails String[]
  // When true, the group is kept around (members, history) but excluded
  // from the campaign recipient picker. Acts like "archive" without
  // destroying data. Admin toggles this from the Audience page.
  disabled      Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Template {
  id        String   @id
  name      String
  subject   String
  html      String
  text      String
  logoUrl   String?
  data      Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Campaign {
  id        String   @id
  name      String
  status    String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Draft {
  id        String   @id
  name      String?
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Unsubscribe {
  // UUID PK + per-account unique email, same model as Contact: a given
  // address can be suppressed independently in each workspace.
  id             String   @id @default(uuid())
  email          String
  reason         String?
  unsubscribedAt DateTime @default(now())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, email])
  @@index([accountId])
}

model Event {
  id         String   @id @default(uuid())
  // Stable id from the upstream provider (Brevo's `uuid` field on each
  // event). Used to dedup when both a webhook AND the catch-up sync see
  // the same event. Postgres allows multiple NULLs in a unique index, so
  // legacy rows without an externalId can coexist.
  externalId String?  @unique
  provider   String
  payload    Json
  receivedAt DateTime @default(now())
  // Webhook handler resolves accountId by looking up the
  // campaign:<id> tag in the payload → Campaign.accountId. Events
  // without a campaign tag (rare: provider keepalives, generic
  // transactional) get routed to the default account for now.
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// Setting stays global. Per-account preferences (sender, hidden
// built-ins, unsubscribe categories, bounce-sync toggle, etc.) live
// either in dedicated Account columns or under Account.data JSON.
// Prisma doesn't allow nullable fields in composite primary keys,
// which ruled out a (key, accountId?) shape — splitting into two
// tables (global Setting + per-account AccountSetting) would have
// worked too, but using Account.data is fewer moving parts for v1.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model User {
  id                      String   @id @default(uuid())
  email                   String   @unique
  passwordHash            String
  name                    String?
  role                    String   @default("admin")
  // Install-level super-admin (distinct from `role`, which is the user's
  // role WITHIN their workspace). A super-admin can see + manage every
  // workspace via the /api/super-admin/* routes. The first user on a
  // fresh install becomes one; everyone else defaults to false.
  isSuperAdmin            Boolean  @default(false)
  notificationsLastSeenAt DateTime?
  // When the user clicks "Clear" in the notifications panel. Items received
  // before this point are hidden from their view (the underlying Event rows
  // are kept for audit / analytics — this is just per-user filtering).
  notificationsClearedAt  DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  // Each user belongs to exactly one Account. Multi-account membership
  // (a single human across many workspaces) would require a UserAccount
  // join table; deferred until we actually need it.
  accountId               String
  account                 Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model CampaignSend {
  campaignId      String
  email           String
  status          String   @default("pending")
  brevoMessageId  String?
  errorMessage    String?
  attempts        Int      @default(0)
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // accountId is denormalized from Campaign.accountId so aggregate
  // queries ("count all sends for account X") don't need a join.
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([campaignId, email])
  @@index([campaignId])
  @@index([accountId])
}

model Segment {
  id        String   @id @default(uuid())
  name      String
  filter    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// Drip sequence. A linear chain of templated emails enrolled contacts get
// over time. v1 trigger: 'group_added' (a contact added to a specific
// Audience starts the sequence). Steps are stored inline as JSON because
// the editor needs ordered, ad-hoc mutation; a separate SequenceStep table
// would buy us very little. SequenceEnrollment tracks each contact's progress.
model Sequence {
  id             String   @id @default(uuid())
  name           String
  status         String   @default("active") // 'active' | 'paused'
  triggerType    String   @default("group_added") // future: 'event', 'manual'
  triggerGroupId String?  // when triggerType='group_added', which Audience id
  // [{ order: 0, delayDays: 0, templateId: 'xxx' }, ...] — first step usually
  // has delayDays=0 (fire on enroll). Stored as JSON for flexible editing.
  steps          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  enrollments    SequenceEnrollment[]

  @@index([accountId])
}

// One row per (sequence, contact) pair. The runner cron scans these for
// pending work and advances `nextStepIndex` after each successful send.
model SequenceEnrollment {
  id            String   @id @default(uuid())
  sequenceId    String
  email         String
  enrolledAt    DateTime @default(now())
  nextStepIndex Int      @default(0)
  // Wall-clock time the next step should fire. null means the enrollment is
  // done (status will reflect that too).
  nextRunAt     DateTime?
  status        String   @default("active") // 'active' | 'completed' | 'unsubscribed' | 'paused'
  lastError     String?

  sequence      Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, email])
  @@index([nextRunAt, status])
}

model Asset {
  id          String   @id @default(uuid())
  fileName    String
  url         String
  contentType String
  bytes       Int
  kind        String   @default("logo")
  createdById String?
  createdAt   DateTime @default(now())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([kind])
  @@index([createdAt])
  @@index([accountId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  // Audit rows are tagged with the account whose data was touched. Some
  // super-admin actions (Account create/suspend/delete) have no parent
  // account — those rows stay null.
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId])
  @@index([userId])
  @@index([createdAt])
  @@index([accountId])
}
